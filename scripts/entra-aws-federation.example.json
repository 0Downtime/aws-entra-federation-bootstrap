{
  "aws": {
    "managementProfile": "management",
    "region": "us-east-1",
    "identityCenterRegion": "us-east-1",
    "startUrl": "https://example.awsapps.com/start",
    "managedProfilePrefix": "org",
    "serviceProviderMetadataPath": "C:\\SecureBootstrap\\aws-iam-identity-center-sp.xml"
  },
  "bootstrap": {
    "requiredAccountCount": 3,
    "requestedAccountQuota": 20,
    "organizationStagePath": "stages\\01-organization"
  },
  "entra": {
    "tenantId": "00000000-0000-0000-0000-000000000000",
    "clientId": "00000000-0000-0000-0000-000000000000",
    "certificateThumbprint": "REPLACE_WITH_CERTIFICATE_THUMBPRINT",
    "applicationDisplayName": "AWS IAM Identity Center",
    "applicationTemplateId": "",
    "identityProviderMetadataPath": "C:\\SecureBootstrap\\entra-idp-metadata.xml"
  },
  "accessMappings": [
    {
      "name": "security-audit",
      "entraGroup": "AWS-SecurityAudit",
      "permissionSet": "SecurityAudit",
      "accountIds": ["all-active-accounts"]
    },
    {
      "name": "billing-read-only",
      "entraGroup": "AWS-BillingReadOnly",
      "permissionSet": "BillingReadOnly",
      "accountIds": ["000000000000"]
    }
  ]
}
